# === Hub Identity ===
APP_ENV=development
HUB_ID=official-main
HUB_NAME=Sowing Discord Hub
WEB_BASE_URL=https://banshi.ankaanka.org
API_BASE_URL=https://banshi-api.ankaanka.org
API_DOMAIN=banshi-api.ankaanka.org

# === Database ===
DATABASE_PATH=./data/hub.db

# === Object Storage ("local" for dev, "r2" for Cloudflare R2) ===
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./data/media
PUBLIC_MEDIA_BASE_URL=http://localhost:8000/media/public
# Production R2 custom domain example: https://cdn.banshi.ankaanka.org
STORAGE_LIMIT_BYTES=10737418240

# Cloudflare R2 (required when STORAGE_BACKEND=r2 — use SEPARATE buckets for public, private & backups!)
R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=sowing-discord-media
R2_PRIVATE_BUCKET_NAME=sowing-discord-media-private
R2_PUBLIC_BUCKET_NAME=sowing-discord-media-public
R2_REGION=auto
# Dedicated Litestream SQLite backup bucket (never publicly exposed!)
R2_BACKUP_BUCKET_NAME=sowing-discord-db-backups
R2_BACKUP_ACCESS_KEY_ID=
R2_BACKUP_SECRET_ACCESS_KEY=

# Optional Cloudflare CDN Cache Purge (for instant Kill Switch takedown)
CF_ZONE_ID=
CF_API_TOKEN=

# === Security & Secrets (MUST change in production) ===
JWT_SECRET=dev-jwt-secret-change-in-production-32bytes
JWT_EXPIRE_SECONDS=86400
HMAC_SALT=dev-hmac-salt-change-in-production
COLLECTOR_HMAC_SECRET=dev-collector-hmac-secret

# Default seeded super_admin (used only if admins table is empty on startup)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123456

# Cloudflare Turnstile (false in local dev, true in production)
TURNSTILE_ENABLED=false
TURNSTILE_SECRET_KEY=

# PoW & Anti-abuse
POW_DIFFICULTY_BITS=16
POW_TTL_SECONDS=300
FEEDBACK_REPORT_THRESHOLD=3
FEEDBACK_INSTANCE_MIN_AGE_HOURS=24
FEEDBACK_MAX_GROUP_CONTRIBUTION=10

# CORS (comma-separated origins, or "*" in dev)
CORS_ORIGINS=*
